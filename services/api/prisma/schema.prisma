generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Family {
  id             String          @id
  name           String
  members        FamilyMember[]
  threads        Thread[]
  plans          Plan[]
  familyMemories FamilyMemory[]
}

model FamilyMember {
  id       String  @id
  familyId String
  name     String
  role     String
  age      Int?
  profile  String  @default("{}")
  family   Family  @relation(fields: [familyId], references: [id])

  threads       Thread[]
  plans         Plan[]
  memoryEntries MemoryEntry[]
  coursePlans   CoursePlanRecord[]
  assignments   AgentAssignment[]
}

model StaffAgent {
  id          String @id
  name        String
  role        String
  specialties String @default("[]")
  stage       String @default("front-stage")
  contract    String @default("{}")
  purpose     String @default("")

  threads     Thread[]
  assignments AgentAssignment[]
  taskOutputs AgentTaskOutput[]
}

model Thread {
  id        String   @id
  familyId  String
  memberId  String
  agentId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family   Family       @relation(fields: [familyId], references: [id])
  member   FamilyMember @relation(fields: [memberId], references: [id])
  agent    StaffAgent   @relation(fields: [agentId], references: [id])
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
}

model Plan {
  id          String     @id @default(cuid())
  familyId    String
  memberId    String
  title       String
  description String
  status      String     @default("draft")
  createdAt   DateTime   @default(now())

  family Family       @relation(fields: [familyId], references: [id])
  member FamilyMember @relation(fields: [memberId], references: [id])
  items  PlanItem[]
}

model PlanItem {
  id        String  @id @default(cuid())
  planId    String
  title     String
  completed Boolean @default(false)

  plan Plan @relation(fields: [planId], references: [id])
}

model MemoryEntry {
  id         String   @id @default(cuid())
  memberId   String
  category   String
  content    String
  tags       String   @default("[]")
  capturedAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id])
}

model CoursePlanRecord {
  id                String   @id @default(cuid())
  memberId          String
  tier              String
  coursesJson       String
  totalHoursPerWeek Float
  totalCostPerMonth Float
  totalFatigueScore Float
  conflictsJson     String   @default("[]")
  score             Float
  createdAt         DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id])
}

model AgentAssignment {
  id           String   @id @default(cuid())
  agentId      String
  memberId     String
  instructions String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent  StaffAgent   @relation(fields: [agentId], references: [id])
  member FamilyMember @relation(fields: [memberId], references: [id])

  @@unique([agentId, memberId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  resource  String
  details   String   @default("{}")
  proofType String?
  timestamp DateTime @default(now())
}

model FamilyMemory {
  id        String   @id @default(cuid())
  familyId  String
  category  String
  content   String
  tags      String   @default("[]")
  createdBy String
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id])
}

model AgentTaskOutput {
  id        String   @id @default(cuid())
  agentId   String
  taskType  String
  output    String
  metadata  String   @default("{}")
  status    String   @default("draft")
  createdAt DateTime @default(now())

  agent StaffAgent @relation(fields: [agentId], references: [id])
}
